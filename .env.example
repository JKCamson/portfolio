# Resend (https://resend.com/api-keys)
# RESEND_API_KEY=re_replace_me

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# TURNSTILE_SECRET_KEY=replace_me
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000BB

# Email addresses
# OWNER_EMAIL=example@gmail.com
# SENDER_EMAIL=onboarding@resend.dev

# Supabase (https://supabase.com). The publishable key is public-by-design;
# RLS gates all access. Do NOT put the Supabase "secret key" here — it is
# server-only and unused in this client-side feature.
# VITE_SUPABASE_URL=replace_me
# VITE_SUPABASE_PUBLISHABLE_KEY=replace_me